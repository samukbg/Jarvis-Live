# Jarvis Live: server configuration.
# Copy to `.env` (repo root) and fill in what you use. `.env` is gitignored: never commit it.

# ── Security ────────────────────────────────────────────────────────────────
# The key every client must send (Settings → Server in the web app).
# If unset, the server generates a random one per run and prints it at startup.
# Generate one with:  openssl rand -hex 24
API_KEY=

# ── Brains ─────────────────────────────────────────────────────────────────
# Google Gemini (Gemini Live voice + the live avatar's conversation engine).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest

# OpenAI Realtime instead of Gemini Live for the orb's live voice (your own OpenAI key,
# roughly $0.02 per minute of conversation). Keys: https://platform.openai.com/api-keys
# LIVE_VOICE_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# OPENAI_REALTIME_VOICE=marin

# Local LLMs via Ollama (comma-separated; least-busy server wins).
# OLLAMA_SERVERS=http://localhost:11434

# Hermes agent: map OpenAI-compatible endpoints to provider names in your Hermes profile.
# HERMES_SERVER_PROVIDERS=http://localhost:11434/v1=ollama

# ── Server ─────────────────────────────────────────────────────────────────
# PORT=4000
# JARVIS_SERVER_NAME=my-jarvis
# Where memory.json / settings live (defaults to the repo root).
# JARVIS_DATA_DIR=
# Public URL of this backend, when the avatar GPU runs on another machine.
# JARVIS_BACKEND_URL=https://jarvis.example.com

# ── Voice ──────────────────────────────────────────────────────────────────
# RealtimeSTT server (voice_engine/code/realtime_stt_server.py).
# STT_URL=ws://localhost:8001
# Optional local TTS endpoint (e.g. Kokoro).
# TTS_SERVER=http://127.0.0.1:8000
# XTTS voice-cloning server (live_avatar/voice_server).
# VOICE_SERVER_PORT=8010

# ── Live avatar (AVTR-1) ───────────────────────────────────────────────────
# The WebRTC streamer. Defaults to this machine.
# STREAMER_URL=http://127.0.0.1:7860
# Refuse new avatar sessions when the GPU is this full / busy.
# AVATAR_MIN_FREE_VRAM_MB=4000
# AVATAR_MAX_GPU_UTIL_PCT=85
# Hugging Face token of an account that accepted the AVTR-1 terms (gated weights + portraits).
# HF_TOKEN=

# ── Dashboard cards (all optional, all empty by default) ──────────────────
# Your EVM wallet address for the wallet card (or set it in Settings → Integrations).
# CRYPTO_WALLET=
# News feeds for the news card, comma-separated RSS URLs.
# NEWS_RSS_URLS=
